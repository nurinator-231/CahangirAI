<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. User data (database) is backed up; credentials are not:
     they are encrypted with a Keystore key that cannot be restored on another device. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="cahangir_secure_vault.xml" />
    <exclude domain="sharedpref" path="cahangir_secure_vault_fallback.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
</full-backup-content>
