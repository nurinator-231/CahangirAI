# Copy to /etc/cahangir/cahangir.env (owner root, mode 600). Never commit real keys.
#
# Network binding. Recommended: bind only to the Tailscale address of the server so the
# API is not reachable from other networks, e.g. CAHANGIR_HOST=100.x.y.z
# CAHANGIR_HOST=0.0.0.0
# CAHANGIR_PORT=8000
#
# ---- AI Router (free tiers only) ----
# Ordered list of providers Cahangir may use. A provider is NEVER used unless it is
# listed here AND its key is set. Remove a provider from the list to disable it.
# CAHANGIR_AI_PROVIDERS=groq,gemini,cerebras,mistral,openrouter,github
#
# GROQ_API_KEY=
# GEMINI_API_KEY=          # AI Studio key (AQ.… or AIza…), project WITHOUT Cloud Billing; no quotes
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=         # 'Experiment' (free) plan
# OPENROUTER_API_KEY=      # only ':free' models are allowed by Cahangir
# GITHUB_MODELS_TOKEN=     # fine-grained PAT with models:read, paid usage disabled
#
# Optional overrides (budgets can only be LOWERED below the free-tier defaults):
# CAHANGIR_AI_GROQ_MODEL=llama-3.3-70b-versatile
# CAHANGIR_AI_GEMINI_RPD=100
# CAHANGIR_AI_ORDER_PARSE=groq,cerebras,gemini
#
# Backups
# CAHANGIR_BACKUP_INTERVAL_HOURS=24
# CAHANGIR_BACKUP_KEEP=14
