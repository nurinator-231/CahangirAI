[Unit]
Description=Cahangir AI Central Memory & Synchronization Backend
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=debian
WorkingDirectory=/opt/cahangir-backend
# Optional secrets/config (AI provider keys, bind address). Not part of the repository.
EnvironmentFile=-/etc/cahangir/cahangir.env
ExecStart=/opt/cahangir-backend/venv/bin/uvicorn app.main:app --host ${CAHANGIR_HOST} --port ${CAHANGIR_PORT} --workers 1 --no-server-header
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=CAHANGIR_HOST=0.0.0.0
Environment=CAHANGIR_PORT=8000

# Low-resource safeguards for Intel Atom D525 (4GB RAM)
MemoryMax=300M
CPUQuota=100%
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
